<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color of the EditText -->
    <solid android:color="#F5F5F5" /> <!-- Light grey background -->

    <!-- Border color and width -->
    <stroke
        android:width="1dp"
        android:color="@color/grey" /> <!-- Using your existing @color/grey -->

    <!-- Rounded corners (optional, adjust as needed) -->
    <corners android:radius="8dp" />

    <!-- Padding inside the EditText (optional, but good for text spacing) -->
    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp" />

</shape>